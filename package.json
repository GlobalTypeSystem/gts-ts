{
  "name": "@globaltypesystem/gts-ts",
  "version": "0.10.0",
  "description": "TypeScript library for working with GTS (Global Type System) identifiers and JSON/JSON Schema artifacts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gts": "./dist/cli/index.js",
    "gts-server": "./dist/server/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "server": "node dist/server/index.js",
    "server:dev": "ts-node src/server/index.ts",
    "csp:repro": "node --disallow-code-generation-from-strings tests/csp/repro.cjs .",
    "csp:scenarios": "node --disallow-code-generation-from-strings tests/csp/scenarios.cjs .",
    "csp:scan": "node scripts/csp-scan.mjs",
    "csp:scan:selftest": "node scripts/csp-scan.mjs --selftest",
    "test:csp": "jest --testEnvironment ./tests/csp/no-codegen-environment.js --testPathIgnorePatterns /node_modules/ server.test.ts staging.test.ts compatibility.property.test.ts",
    "test:csp:browser": "playwright test --config playwright.config.ts",
    "bench": "node scripts/bench.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GlobalTypeSystem/gts-ts.git"
  },
  "keywords": [
    "gts",
    "global-type-system",
    "json",
    "jsonschema",
    "validation"
  ],
  "author": "Global Type System",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "ajv": "^8.18.0",
    "esbuild": "0.28.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "fastify": "^5.12.5",
    "json-schema-library": "11.6.14",
    "jsonc-parser": "^3.3.1",
    "re2js": "^2.8.6",
    "uuid": "^11.1.1",
    "yaml": "^2.9.1"
  }
}
